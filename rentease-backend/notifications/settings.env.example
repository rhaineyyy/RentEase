# APPEND these settings to existing backend .env; keep working DB/SMS/SMTP values.
NOTIFICATIONS_TEST_MODE=true
# Comma-separated actual recipients permitted while test mode is true.
SMS_ALLOWED_NUMBERS=639XXXXXXXXX
EMAIL_ALLOWED_RECIPIENTS=your_test_email@example.com
# Existing tested values required:
# MOCEAN_API_TOKEN=
# MOCEAN_SENDER=MOCEAN
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=your_verified_sender@example.com
# SMS_TEST_NUMBER / EMAIL_TEST_TO are for standalone tests, not actual workflow recipients.

# Enable calendar reminders after installing updated install.sql.
NOTIFICATIONS_REMINDERS_ENABLED=true
